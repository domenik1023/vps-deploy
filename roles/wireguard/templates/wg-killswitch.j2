#!/bin/bash
# Managed by Ansible - roles/wireguard/templates/wg-killswitch.j2. Local edits
# are overwritten on the next run.
#
#   wg-killswitch on          install the filter/DROP rules
#   wg-killswitch off         remove them
#   wg-killswitch fix-route   (re)position the SSH routing rule - see below;
#                             must run after `wg-quick up`, never before
#
# Nothing leaves {{ wg_wan_interface_resolved }} except the tunnel's own
# packets and the exceptions listed under "the host itself" below. Everything
# else is expected to go through {{ wg_interface }}, which holds the default
# route while it is up. When it is down, traffic is dropped rather than
# escaping on the VPS's public address - that is the point.
#
# Three places, because one is not enough:
#
#   routing   a plain `ip rule` sends SSH's own traffic to the main routing
#             table instead of the tunnel's, by source port alone. Without it,
#             replies to an inbound SSH connection would be routed into the
#             tunnel and the session would hang the instant the default route
#             moved. Installed by `fix-route`, not `on` - see below for why
#             that split is load-bearing, not stylistic.
#   filter    OUTPUT covers traffic the host originates.
#   filter    DOCKER-USER covers containers. They are forwarded traffic, and
#             Docker's own FORWARD jumps run ahead of ufw's, so a rule in
#             ufw-before-forward would never be reached.
#
# It also carries one rule that is not about dropping anything at all: an MSS
# clamp in mangle FORWARD, which is what stops container traffic black-holing
# on the tunnel's MTU. It lives here because this script is already idempotent,
# already does both address families, and is already restarted by Reload UFW -
# and the same `ufw reload` that flushes the chains above flushes that rule
# too. See wg_mss_clamp in defaults/main.yml for why it is needed.
#
# Every chain here is created by this script and jumped into from a builtin.
# `ufw reload` flushes the builtins and takes those jumps with it, so the
# Reload UFW handler restarts this unit - the same reason it restarts the
# CrowdSec bouncer.
#
# SSH is the only thing on these hosts that accepts inbound internet
# connections, so it is handled with an `ip rule` matched on the SSH port
# alone - no packet marking, no conntrack, nothing that depends on catching
# the connection's first inbound packet. An earlier version of this script
# used CONNMARK to mark inbound-then-reply traffic generically, but that
# mechanism collides with wg-quick's own fwmark: wg-quick's own
# `not fwmark <t> table <t>` rule is an *unmasked* exact match, so ANY bit
# added to a packet already carrying wg-quick's fwmark - correctly masked or
# not - changes the value away from the one that rule requires, which routes
# the tunnel's own re-keys and keepalives into itself the moment anything on
# that flow got marked. See CLAUDE.md's "WireGuard on [vpn] hosts" section.
# The sport-based rule has none of that: it matches the packet's own header,
# not a mark that has to survive being combined with something else's.
#
# That rule's PRIORITY is not a fixed number, and cannot be. wg-quick adds its
# own two rules (`not fwmark <t> table <t>` and `table main
# suppress_prefixlength 0`) with no `priority` argument at all, and the
# kernel's rule for "no priority given" is not 32764/32765 or any other fixed
# value - it is (lowest priority currently in use) - 1, for each rule added,
# in order. That makes a static priority for our own rule inherently racy:
# whatever number is installed *before* wg-quick runs is exactly what
# wg-quick's own rules land one (and two) below, every single time. This is
# not hypothetical - it is what CLAUDE.md's priority history (32764 assumed,
# then 30000 observed as insufficient, then 100) actually was: every fix was a
# real number that briefly worked and then got undercut, because the fix
# itself was what wg-quick was undercutting.
#
# The only stable order is to go last: `fix-route` deletes our own rule
# first - so it cannot be the floor wg-quick reacts to - then, once
# `wg-quick up` has already run and installed whatever it is going to, reads
# `ip rule show` and installs our rule one below the actual result. This must
# never run before `wg-quick up`; roles/wireguard/tasks/tunnel.yml calls it
# immediately after, in the same command, so there is no gap where SSH's
# reply has nothing to route it out correctly.
set -euo pipefail

WAN='{{ wg_wan_interface_resolved }}'
WG_IF='{{ wg_interface }}'
SSH_PORT='{{ ssh_port }}'
WG_PORT='{{ wg_peer_endpoint.rsplit(":", 1)[1] }}'

# The mark the CONNMARK-based mechanism used before it was replaced by the
# sport-based ip rule below. Kept only so `on` can clean up the chains, jumps
# and ip rule a host upgraded from that version still has - a fresh host has
# never had any of it, and every removal here is a no-op there.
OLD_MARK='0x40000'
OLD_MARK_CHAIN='WG-KILLSWITCH-MARK'
OLD_RESTORE_CHAIN='WG-KILLSWITCH-RESTORE'

OUT_CHAIN='WG-KILLSWITCH-OUT'
FWD_CHAIN='WG-KILLSWITCH-FWD'
MSS_CHAIN='WG-KILLSWITCH-MSS'

# Create the chain, or empty it if a previous run left it there. Rebuilding
# from empty is what makes this safe to run repeatedly, including from the
# Reload UFW handler.
ensure_chain() {
    local ipt=$1 table=$2 chain=$3
    "$ipt" -t "$table" -N "$chain" 2>/dev/null || "$ipt" -t "$table" -F "$chain"
}

remove_chain() {
    local ipt=$1 table=$2 chain=$3
    "$ipt" -t "$table" -F "$chain" 2>/dev/null || true
    "$ipt" -t "$table" -X "$chain" 2>/dev/null || true
}

# Delete every copy of the rule first, then insert one at the top. -D in a loop
# rather than once: a crashed run, or a Docker restart between runs, can leave
# more than one behind, and a duplicate jump is a rule that survives `off`.
ensure_jump() {
    local ipt=$1 table=$2 parent=$3
    shift 3
    while "$ipt" -t "$table" -D "$parent" "$@" 2>/dev/null; do :; done
    "$ipt" -t "$table" -I "$parent" 1 "$@"
}

remove_jump() {
    local ipt=$1 table=$2 parent=$3
    shift 3
    while "$ipt" -t "$table" -D "$parent" "$@" 2>/dev/null; do :; done
}

# The chain exists in this family, whether we made it or Docker did.
has_chain() {
    "$1" -t "$2" -L "$3" -n >/dev/null 2>&1
}

# Whether this address family can be configured at all.
#
# A host with IPv6 turned off has no ip6tables tables and no `ip -6 rule`, and
# every v6 command below fails. Without this check the first of them aborts the
# script under `set -e` - half way through, after the v4 rules are in but
# before the v6 filter chain exists - and the unit lands in `failed` with the
# host protected on one family and not the other. Check once, and skip the
# family cleanly instead.
family_usable() {
    local ipt=$1 fam=$2
    [ "$fam" = 4 ] && return 0
    [ -e /proc/net/if_inet6 ] || return 1
    "$ipt" -t mangle -L -n >/dev/null 2>&1 || return 1
    ip -6 rule show >/dev/null 2>&1 || return 1
}

# Removes what the CONNMARK-based mechanism this replaced left behind. Called
# from both build() and teardown() so neither `on` nor `off` leaves an
# upgraded host carrying orphaned chains or a stale fwmark ip rule.
remove_old_mark_mechanism() {
    local ipt=$1 fam=$2
    remove_jump "$ipt" mangle PREROUTING -i "$WAN" -j "$OLD_MARK_CHAIN"
    remove_jump "$ipt" mangle OUTPUT -j "$OLD_RESTORE_CHAIN"
    remove_chain "$ipt" mangle "$OLD_MARK_CHAIN"
    remove_chain "$ipt" mangle "$OLD_RESTORE_CHAIN"
    while ip -"$fam" rule del fwmark "$OLD_MARK/$OLD_MARK" table main 2>/dev/null; do :; done
}

# (Re)installs the SSH routing rule at a priority one below whatever is
# currently the lowest `ip rule` entry - see the header comment for why this
# has to be computed at run time instead of configured as a fixed number, and
# why this function must only ever be called after `wg-quick up`.
#
# Excludes 0 (kernel's own "local"), 32766 ("main") and 32767 ("default") -
# those are always present and are not what this needs to stay below; the
# thing that matters is wg-quick's own two rules, whatever priority the
# kernel gave them.
fix_route() {
    local fam=$1
    while ip -"$fam" rule del ipproto tcp sport "$SSH_PORT" table main 2>/dev/null; do :; done
    local lowest
    lowest=$(ip -"$fam" rule show | awk -F: '$1 !~ /^(0|32766|32767)$/ {print $1}' | sort -n | head -1)
    if [ -z "$lowest" ]; then
        # Nothing else here yet - wg-quick has not run, or added nothing for
        # this family (no v6 tunnel). The default route is still the ordinary
        # one, so SSH does not need help escaping and there is nothing to
        # position below; a plain host route is enough on its own.
        return 0
    fi
    ip -"$fam" rule add ipproto tcp sport "$SSH_PORT" table main priority "$((lowest - 1))"
}

build() {
    local ipt=$1 fam=$2

    remove_old_mark_mechanism "$ipt" "$fam"
{% if wg_mss_clamp %}

    # --- mangle FORWARD: MSS clamping for forwarded traffic ---
    # Containers sit on a 1500-MTU bridge and negotiate MSS from that, because
    # they cannot see {{ wg_interface }}'s {{ wg_mtu }}. Traffic this host
    # originates is fine - the kernel sizes the MSS it advertises from the
    # route - but a router never rewrites the MSS of traffic it forwards, so
    # the remote end sends segments that do not fit the tunnel. Those die at
    # OPNsense and the ICMP saying so has to cross the internet back to the
    # remote, where it is usually filtered. Handshakes complete, ping works,
    # and every transfer larger than one segment hangs.
    #
    # Only -o "$WG_IF". --clamp-mss-to-pmtu clamps against the *outgoing*
    # route's MTU, so the same rule on the way in would clamp against the
    # bridge's 1500 and do nothing at all. That direction needs no help: this
    # host generates the ICMP itself, over a veth, and the container honours
    # it.
    #
    # --tcp-flags SYN,RST SYN matches SYN and SYN/ACK both, so a container
    # serving an inbound connection over the tunnel is covered by the same
    # rule. v6 needs no separate value either - the target subtracts 60 rather
    # than 40 on its own.
    ensure_chain "$ipt" mangle "$MSS_CHAIN"
    "$ipt" -t mangle -A "$MSS_CHAIN" -p tcp --tcp-flags SYN,RST SYN \
        -j TCPMSS --clamp-mss-to-pmtu
    ensure_jump "$ipt" mangle FORWARD -o "$WG_IF" -j "$MSS_CHAIN"
{% endif %}

    # --- filter OUTPUT: the host itself ---
    ensure_chain "$ipt" filter "$OUT_CHAIN"

    # Loopback, {{ wg_interface }} and every bridge in one rule: only the
    # public interface is policed here, and a container reaching the host is
    # 40_firewall.yml's job.
    "$ipt" -A "$OUT_CHAIN" ! -o "$WAN" -j RETURN

    # The tunnel's own packets, or it could never come up.
    "$ipt" -A "$OUT_CHAIN" -p udp --dport "$WG_PORT" -j RETURN

    # Replies to an inbound SSH session, matched on the source port - the same
    # selector the ip rule above uses, so a packet allowed out here is always
    # one the routing decision already sent the right way.
    "$ipt" -A "$OUT_CHAIN" -p tcp --sport "$SSH_PORT" -j RETURN

    # Address configuration. Without these the host loses its own address when
    # the DHCP lease expires, or when a router advertisement goes unanswered -
    # a slow failure that looks nothing like a firewall problem.
    if [ "$fam" = 4 ]; then
        "$ipt" -A "$OUT_CHAIN" -p udp --sport 68 --dport 67 -j RETURN
    else
        "$ipt" -A "$OUT_CHAIN" -p ipv6-icmp -j RETURN
        "$ipt" -A "$OUT_CHAIN" -p udp --sport 546 --dport 547 -j RETURN
    fi
{% if wg_killswitch_allow_dns %}

    # Resolving wg_peer_endpoint, which has to happen before the tunnel that
    # would otherwise carry DNS can come up. See wg_killswitch_allow_dns.
    "$ipt" -A "$OUT_CHAIN" -p udp --dport 53 -j RETURN
    "$ipt" -A "$OUT_CHAIN" -p tcp --dport 53 -j RETURN
{% endif %}
{% for spec in wg_killswitch_extra_allow %}
    "$ipt" -A "$OUT_CHAIN" {{ spec }} -j RETURN
{% endfor %}

    "$ipt" -A "$OUT_CHAIN" -j DROP
    ensure_jump "$ipt" filter OUTPUT -j "$OUT_CHAIN"

    # --- filter DOCKER-USER: containers ---
    # Created if absent so that this unit can run before dockerd; Docker's own
    # -N is a no-op on a chain that already exists. Skipped for IPv6 unless
    # Docker made one, because without Docker IPv6 there is no v6 container
    # traffic to forward.
    if [ "$fam" = 4 ]; then
        "$ipt" -N DOCKER-USER 2>/dev/null || true
    fi
    if has_chain "$ipt" filter DOCKER-USER; then
        ensure_chain "$ipt" filter "$FWD_CHAIN"
        # Nothing from the internet reaches a container: published ports are
        # bound on every address, and Docker's FORWARD rules accept them
        # regardless of ufw. Reach them over the tunnel instead.
        "$ipt" -A "$FWD_CHAIN" -i "$WAN" -j DROP
        # And no container egress outside the tunnel.
        "$ipt" -A "$FWD_CHAIN" -o "$WAN" -j DROP
        "$ipt" -A "$FWD_CHAIN" -j RETURN
        ensure_jump "$ipt" filter DOCKER-USER -j "$FWD_CHAIN"
    fi
}

teardown() {
    local ipt=$1 fam=$2

    remove_old_mark_mechanism "$ipt" "$fam"

    # Unconditional, unlike the matching half of build(): turning wg_mss_clamp
    # off has to remove a rule an earlier run installed, and a restart runs the
    # new script's `off` before its `on`.
    remove_jump "$ipt" mangle FORWARD -o "$WG_IF" -j "$MSS_CHAIN"
    remove_jump "$ipt" filter OUTPUT -j "$OUT_CHAIN"
    if has_chain "$ipt" filter DOCKER-USER; then
        remove_jump "$ipt" filter DOCKER-USER -j "$FWD_CHAIN"
    fi

    remove_chain "$ipt" mangle "$MSS_CHAIN"
    remove_chain "$ipt" filter "$OUT_CHAIN"
    remove_chain "$ipt" filter "$FWD_CHAIN"

    # By selector (protocol and port), not by priority - fix_route() computes
    # the priority fresh every time it runs, so there is no fixed value to
    # match against, and a rule from any priority this script has ever used
    # has to go.
    while ip -"$fam" rule del ipproto tcp sport "$SSH_PORT" table main 2>/dev/null; do :; done
}

# Within build() the final DROP is the last rule added, so a build that dies
# part way leaves a chain that has not started dropping anything yet. That is
# the right direction to fail in for the run that installs it: an incomplete
# kill switch leaks, a half-built one that dropped first would take SSH with it.
case "${1:-}" in
    on)
        build iptables 4
        if family_usable ip6tables 6; then
            build ip6tables 6
        else
            echo "wg-killswitch: IPv6 unavailable on this host, skipping v6 rules" >&2
        fi
        ;;
    off)
        teardown iptables 4
        if family_usable ip6tables 6; then
            teardown ip6tables 6
        fi
        ;;
    fix-route)
        fix_route 4
        if family_usable ip6tables 6; then
            fix_route 6
        fi
        ;;
    *)
        echo "usage: $(basename "$0") on|off|fix-route" >&2
        exit 2
        ;;
esac
