# Template for a [vpn] host. Copy to host_vars/<name>.yml, fill in from the
# peer you register on OPNsense (VPN: WireGuard: Peers), and add <name> to
# [vpn] in the inventory. See docs/wireguard.md for the OPNsense side and for
# what to check before the first run.
#
# The .example suffix keeps this file out of both Ansible's host_vars loading
# and the per-host loop in tests/render-check.yml.

# The key this host accepts. Only needed when it differs from the one the rest
# of the fleet uses - a provider that injects its own key for the first boot,
# say. It overrides --private-key on the command line, so the usual invocation
# keeps working for every other host.
# ansible_ssh_private_key_file: ~/.ssh/provider-bootstrap

# Reach it on the public address for the first run. The hardening tasks move
# sshd to ssh_port and then deny ssh_old_port, so set this to 22822 afterwards.
#
# Keep using the public address, not the tunnel address, for the bootstrap run
# - the tunnel is built by the run, so it does not exist yet. vpn_ip below is
# an opt-in way to switch every *later* run onto the tunnel address instead;
# until you set it, this is the only address used and nothing here changes.
ansible_host: "{{ vpn_ip | default('203.0.113.10') }}"
ansible_port: 22

# Once the tunnel is proven stable, set this to route all future Ansible runs
# through it instead of the public address (matches wg_address without the
# /32). There is no automatic fallback: if the tunnel happens to be down when
# you run the play, the run fails to connect at all, rather than quietly using
# the public address - direct SSH to the public IP still works regardless,
# since the kill switch's SSH exception is independent of tunnel health, but
# `ansible-playbook` itself is not. Leave this unset until you want that
# tradeoff; comment it back out to revert to the public address.
# vpn_ip: 10.99.0.10

# --- The tunnel ---
# The address you assign this peer on OPNsense, as a /32. Keep it narrow: this
# is what OPNsense uses to decide which source address is legitimately this
# peer, and anything wider would accept spoofed traffic claiming to be another
# peer.
wg_address: 10.99.0.10/32

# A public resolver. There is no LAN to hand this host a resolver for - it is
# an isolated peer, not an extension of the LAN - so point it at whatever
# OPNsense's own peer_dns is set to, or a public one directly.
wg_dns:
  - 9.9.9.9

# From OPNsense's WireGuard instance page: its own public key and host:port.
# Prefer a bare IP if OPNsense's address is static, because a DNS name has to
# be resolved before the tunnel can come up - see wg_killswitch_allow_dns.
wg_peer_public_key: "REPLACE_WITH_OPNSENSES_PUBLIC_KEY"
wg_peer_endpoint: "vpn.example.com:51820"

# Secrets. Never in plain text here - encrypt each one in place:
#
#   ansible-vault encrypt_string --name wg_preshared_key '<PresharedKey>'
#
# and paste what it prints. Leave wg_preshared_key out if the peer does not use
# one - but if OPNsense's peer entry has one, omitting it here gives a tunnel
# that comes up and never handshakes. Plain text here works too; see
# "Vaulting, or not" in docs/wireguard.md for what that costs.
#
# wg_preshared_key: !vault |
#           $ANSIBLE_VAULT;1.1;AES256
#           ...

# --- The private key ---
# OPNsense never hands out a client private key - a peer entry only ever holds
# the client's public key - so every OPNsense-backed host takes this path: the
# keypair is generated on the host and never travels.
#
# The first run generates it, prints the public half, and stops before
# touching routing; register that public key on OPNsense as a peer, with this
# host's wg_address above as its Allowed IPs, then run again. See
# docs/wireguard.md.
wg_generate_key: true

# The interface reaching the internet without the tunnel. Derived from the
# default route in the main routing table, which names it whether the tunnel is
# up or not - including on a NAT'd host, where the VM sees only a private
# address and the public one lives on a router. Set it only for a host with
# more than one default route, where picking the first is a coin toss.
# wg_wan_interface: ens3
